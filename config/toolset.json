{
  "schemaVersion": 1,
  "hosts": {
    "win-x86": {
      "directory": "win-x86",
      "binary": "hosts/win-x86/makensis.exe",
      "architecture": "x86",
      "compatibleHostRids": ["win-x86", "win-x64"],
      "requiredEnvironment": { "NSISDIR": { "toolsetRelativePath": "common" } },
      "unixExecutable": false,
      "minimumOs": "Windows Server 2022 is CI-verified; older support follows the upstream official binary and is not asserted"
    },
    "linux-x64": {
      "directory": "linux-x64",
      "binary": "hosts/linux-x64/makensis",
      "architecture": "x64",
      "compatibleHostRids": ["linux-x64"],
      "requiredEnvironment": { "NSISDIR": { "toolsetRelativePath": "common" } },
      "unixExecutable": true,
      "minimumOs": "Linux kernel 3.2 target baseline; no glibc runtime dependency; CI-verified on Ubuntu 24.04"
    },
    "linux-arm64": {
      "directory": "linux-arm64",
      "binary": "hosts/linux-arm64/makensis",
      "architecture": "arm64",
      "compatibleHostRids": ["linux-arm64"],
      "requiredEnvironment": { "NSISDIR": { "toolsetRelativePath": "common" } },
      "unixExecutable": true,
      "minimumOs": "Linux kernel 3.7 target baseline; no glibc runtime dependency; CI-verified on Ubuntu 24.04 ARM64"
    },
    "osx-x64": {
      "directory": "osx-x64",
      "binary": "hosts/osx-x64/makensis",
      "architecture": "x64",
      "compatibleHostRids": ["osx-x64"],
      "requiredEnvironment": { "NSISDIR": { "toolsetRelativePath": "common" } },
      "unixExecutable": true,
      "minimumOs": "macOS 10.13"
    },
    "osx-arm64": {
      "directory": "osx-arm64",
      "binary": "hosts/osx-arm64/makensis",
      "architecture": "arm64",
      "compatibleHostRids": ["osx-arm64"],
      "requiredEnvironment": { "NSISDIR": { "toolsetRelativePath": "common" } },
      "unixExecutable": true,
      "minimumOs": "macOS 11.0"
    }
  },
  "launchers": {
    "windows": "makensis.cmd",
    "posix": "makensis"
  }
}
